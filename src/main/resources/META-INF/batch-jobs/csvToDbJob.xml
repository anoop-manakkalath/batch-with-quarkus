<?xml version="1.0" encoding="UTF-8"?>
<job id="csvToDbJob" xmlns="https://jakarta.ee/xml/ns/jakartaee" version="2.0">
    <step id="csvToDbStep">
        <chunk item-count="#{jobParameters['chunkSize']}">
            <reader ref="csvItemReader">
	            <properties>
	                <property name="startOffset" value="#{partitionPlan['startOffset']}"/>
	                <property name="endOffset" value="#{partitionPlan['endOffset']}"/>
	                <property name="partitionIndex" value="#{partitionPlan['partitionIndex']}"/>
	            </properties>
            </reader>
            <processor ref="bookItemProcessor"/>
            <writer ref="bookItemWriter"/>
        </chunk>
        <partition>
            <plan partitions="8" />
	        <mapper ref="genericBytePartitionMapper"/>
	    </partition>
    </step>
</job>
