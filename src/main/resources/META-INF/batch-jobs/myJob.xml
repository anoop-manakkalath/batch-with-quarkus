<?xml version="1.0" encoding="UTF-8"?>
<job id="myJob" xmlns="https://jakarta.ee/xml/ns/jakartaee" version="2.0">
    <step id="processStep">
        <chunk item-count="#{jobParameters['chunkSize']}">
            <reader ref="csvItemReader"/>
            <processor ref="bookItemProcessor"/>
            <writer ref="bookItemWriter"/>
        </chunk>
    </step>
</job>
